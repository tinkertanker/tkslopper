#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

command -v node >/dev/null 2>&1
command -v pnpm >/dev/null 2>&1

if [[ ! -d node_modules ]]; then
  echo '[resume] dependencies are missing; rerun .agents/setup.' >&2
  exit 1
fi

printf '[resume] ready: Node.js %s, pnpm %s\n' "$(node --version)" "$(pnpm --version)"
