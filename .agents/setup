#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local label="$1"
  shift
  local started_at=$SECONDS

  printf '[setup] %s\n' "$label"
  "$@"
  printf '[setup] completed in %ss: %s\n' "$((SECONDS - started_at))" "$label"
}

if ! command -v node >/dev/null 2>&1; then
  echo '[setup] Node.js is missing; Amp orb templates must provide Node.js 22 or newer.' >&2
  exit 1
fi

node_major="$(node -p 'Number(process.versions.node.split(".")[0])')"
if ((node_major < 22)); then
  echo "[setup] Node.js 22 or newer is required; found $(node --version)." >&2
  exit 1
fi

if ! command -v corepack >/dev/null 2>&1; then
  echo '[setup] Corepack is missing from the Node.js installation.' >&2
  exit 1
fi

run_step 'enable Corepack shims' corepack enable
run_step 'activate pnpm 10.15.1' corepack prepare pnpm@10.15.1 --activate

if [[ "$(pnpm --version)" != '10.15.1' ]]; then
  echo "[setup] Expected pnpm 10.15.1; found $(pnpm --version)." >&2
  exit 1
fi

run_step 'install workspace dependencies' pnpm install --frozen-lockfile

printf '[setup] ready: Node.js %s, pnpm %s\n' "$(node --version)" "$(pnpm --version)"
